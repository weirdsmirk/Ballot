{
  "name": "ballot",
  "description": "Ballot — a reusable election management platform",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "ELECTION_DEMO_OTP=1 vite",
    "dev:secure": "vite",
    "build": "vite build",
    "start": "vite preview --host 127.0.0.1",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "audit": "env -u npm_config_allow_scripts npm audit --omit=dev --ignore-scripts",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^25.0.0",
    "sql.js": "^1.14.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true
  }
}
